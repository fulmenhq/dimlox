# Normalize line endings
* text=auto eol=lf

*.go       text diff=go
Makefile   text eol=lf
*.sh       text eol=lf
*.ps1      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.toml     text eol=lf
VERSION    text eol=lf

# Binary artifacts and archives must never be line-normalized.
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary
*.zip      binary
*.gz       binary
*.bz2      binary
*.xz       binary
*.zst      binary
*.tar      binary
*.tgz      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
